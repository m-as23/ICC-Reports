{
  "name": "maintrack-android",
  "version": "0.3.0-pilot",
  "private": true,
  "scripts": {
    "check": "node --check scripts/snapshot.mjs && node --check scripts/harden-native.mjs && node --check scripts/icons.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "node scripts/snapshot.mjs",
    "android:prepare": "npx cap add android && npx cap sync android && node scripts/harden-native.mjs",
    "android:icons": "node scripts/icons.mjs && npx capacitor-assets generate --android --iconBackgroundColor \"#071521\" --iconBackgroundColorDark \"#071521\" --splashBackgroundColor \"#071521\" --splashBackgroundColorDark \"#071521\"",
    "android:debug": "cd android && chmod +x gradlew && ./gradlew --no-daemon assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capgo/capacitor-updater": "8.53.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@capacitor/assets": "3.0.5",
    "sharp": "0.34.4"
  },
  "engines": {
    "node": ">=22"
  }
}
