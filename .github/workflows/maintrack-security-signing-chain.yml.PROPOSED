# REVIEW PROPOSAL ONLY. Extension prevents GitHub Actions execution.
# Never rename to .yml until trusted receipt provider, Owner artifact receipts and protected
# environments are real, and all alternate publish/sign paths enforce same gate.
name: MainTrack reviewed pre-sign and post-sign chain
on:
  workflow_dispatch:
permissions:
  contents: read
  actions: read
jobs:
  pre-sign:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    environment: maintrack-production-approval
    steps:
      # Source-pinned trusted runner under Owner-approved single-owner policy must fetch actual candidate artifact,
      # exact run/commit metadata, explicit Owner digest+certificate signoff through the GitHub API,
      # artifact substitution rejection, and real
      # environment approval and gated-job-start ordering. Candidate report fields are insufficient.
      - name: Require trusted receipt provider
        run: |
          echo 'BLOCKED: actual Owner artifact comment/environment receipt and mandatory QA evidence required'
          exit 1
      # Call signing_chain.pre_sign(unsigned APK, trusted normalized receipts).
      # No certificate verification is demanded from an unsigned APK here.
      # No signing key environment or secret may be read before this passes.
  sign:
    needs: pre-sign
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: maintrack-android-release
    steps:
      - name: Signing integration requires separate Owner approval
        run: exit 1
      # Trusted signer consumes byte-identical approved unsigned APK; no replacement
      # artifact/download by name only and no untrusted source checkout here.
  post-sign:
    needs: sign
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Post-sign integration remains blocked until reviewed
        run: exit 1
      # Verify apksigner success and reviewed PUBLIC certificate fingerprint,
      # exact unsigned identity, identical nonsignature ZIP payload entries,
      # record new signed APK SHA, source/run/unsigned artifact binding.
      # Release publication depends on this gate plus all required security cases.
